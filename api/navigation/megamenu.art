; Megamenu
;
; Each item has a title and panel content. Generates native popover wiring,
; an active indicator, and a Menu button for small screens.
; The menu is horizontal on larger screens, vertical when opened on small ones.
; IDs are randomly generated by default; names below are illustrative.
; Panels accept custom content without imposing a menu/list structure.

megamenu [
    item "Products" [
        link.href: "/petal" "Petal UI"
        link.href: "/tools" "Developer tools"
    ]
    item "Company" [
        link.href: "/about" "About"
        link.href: "/contact" "Contact"
    ]
]

; => <button type="button" class="btn sm:hidden" popovertarget="megamenu-a7f3c9e2">Menu</button>
; <div class="megamenu max-sm:megamenu-vertical" id="megamenu-a7f3c9e2" popover>
;   <span class="megamenu-active" aria-hidden="true"></span>
;   <button type="button" popovertarget="megamenu-panel-b8e4d0f3">Products</button>
;   <div id="megamenu-panel-b8e4d0f3" popover>
;     <a class="link" href="/petal">Petal UI</a>
;     <a class="link" href="/tools">Developer tools</a>
;   </div>
;   <button type="button" popovertarget="megamenu-panel-c9f5e1a4">Company</button>
;   <div id="megamenu-panel-c9f5e1a4" popover>
;     <a class="link" href="/about">About</a>
;     <a class="link" href="/contact">Contact</a>
;   </div>
; </div>


; Megamenu with wide panels
;
; .wide makes panels as wide as the megamenu container.

megamenu.wide [
    item "Products" [
        link.href: "/petal" "Petal UI"
        link.href: "/tools" "Developer tools"
    ]
]

; => <button type="button" class="btn sm:hidden" popovertarget="megamenu-d0a6f2b5">Menu</button>
; <div class="megamenu max-sm:megamenu-vertical megamenu-wide" id="megamenu-d0a6f2b5" popover>
;   <span class="megamenu-active" aria-hidden="true"></span>
;   <button type="button" popovertarget="megamenu-panel-e1b7a3c6">Products</button>
;   <div id="megamenu-panel-e1b7a3c6" popover>
;     <a class="link" href="/petal">Petal UI</a>
;     <a class="link" href="/tools">Developer tools</a>
;   </div>
; </div>


; Full-width Megamenu with custom IDs and composed content
;
; .full spans the page width. .id on the megamenu sets the mobile target;
; .id on an item sets that panel's ID and its trigger's target.
; Custom IDs must be unique in the page, including across menu and panels.

megamenu.full.id: "main-menu" [
    item.id: "products-panel" "Products" [
        h3 "Build with Petal UI"
        p "Explore our components and developer tools."
        link.primary.href: "/docs" "Read the docs"
    ]
]

; => <button type="button" class="btn sm:hidden" popovertarget="main-menu">Menu</button>
; <div class="megamenu max-sm:megamenu-vertical megamenu-full" id="main-menu" popover>
;   <span class="megamenu-active" aria-hidden="true"></span>
;   <button type="button" popovertarget="products-panel">Products</button>
;   <div id="products-panel" popover>
;     <h3>Build with Petal UI</h3>
