; </nav>


; Navbar without center content
;
; Slot content may be an element or a composed block.

navbar #[
    start: a.href: "/" "Petal UI"
    end: [
        link.href: "/help" "Help"
        avatar.circle.alt: "Ana" "ana.jpg"
    ]
]

