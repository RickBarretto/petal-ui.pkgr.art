; Navbar
;
; Named start, center, and end slots generate corresponding navbar wrappers.
; All slots are optional; only supplied slots produce wrappers.
; Width, background, and shadow use ordinary utility attributes.

navbar.bg: 'base100 .shadow: 'sm #[
    start: a.href: "/" "Petal UI"
    center: menu.horizontal [
        li -> a.href: "/docs" "Docs"
        li -> a.href: "/components" "Components"
    ]
    end: button.primary "Sign in"
]

