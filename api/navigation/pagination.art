; Pagination
;
; A named navigation landmark joins the supplied buttons or button-style links.
; Adds join-item directly to each control. An active control also receives
; aria-current="page". URLs and page labels are supplied explicitly.
; No route generation, automatic page windows, or invented click handlers.

pagination [
    a.as: :button .href: "/?page=1" "1"
    a.as: :button .active.href: "/?page=2" "2"
    a.as: :button .href: "/?page=3" "3"
]

; => <nav class="join" aria-label="Pagination">
;   <a role="button" class="btn join-item" href="/?page=1">1</a>
;   <a role="button" class="btn btn-active join-item" href="/?page=2" aria-current="page">2</a>
;   <a role="button" class="btn join-item" href="/?page=3">3</a>
; </nav>


; Pagination with buttons and a disabled boundary control
;
; Existing Button attributes keep their meaning. Disabled buttons use the
; native disabled attribute. Actions can be wired separately by the application.

pagination [
    button.disabled "Previous"
    button.active "1"
    button "2"
    button "Next"
]

; => <nav class="join" aria-label="Pagination">
;   <button class="btn join-item" disabled>Previous</button>
;   <button class="btn btn-active join-item" aria-current="page">1</button>
;   <button class="btn join-item">2</button>
;   <button class="btn join-item">Next</button>
; </nav>


; Pagination sizes
;
; A pagination size modifier applies the corresponding btn size to its controls,
; not to the navigation container. Medium is the default.

pagination.xs [button.active "1"]

; => <nav class="join" aria-label="Pagination">
;   <button class="btn btn-xs btn-active join-item" aria-current="page">1</button>
; </nav>

pagination.sm [button.active "1"]

; => <nav class="join" aria-label="Pagination">
;   <button class="btn btn-sm btn-active join-item" aria-current="page">1</button>
; </nav>

pagination.lg [button.active "1"]

; => <nav class="join" aria-label="Pagination">
;   <button class="btn btn-lg btn-active join-item" aria-current="page">1</button>
; </nav>

pagination.xl [button.active "1"]

; => <nav class="join" aria-label="Pagination">
;   <button class="btn btn-xl btn-active join-item" aria-current="page">1</button>
; </nav>
