; Progress bar
;
; A numeric value generates the native progress value attribute.
; Maximum defaults to 100; .max overrides it and must be positive.
; Values must be between zero and max. .label labels the progress element.

progress.label: "Upload" 40

; => <progress class="progress" value="40" max="100" aria-label="Upload"></progress>


; Colored Progress with custom maximum

progress.primary.max: 200 .label: "Files uploaded" 80

; => <progress class="progress progress-primary" value="80" max="200" aria-label="Files uploaded"></progress>


; Indeterminate Progress
;
; null omits value entirely, preserving the native indeterminate state.

progress.label: "Searching" null

; => <progress class="progress" max="100" aria-label="Searching"></progress>


; Progress colors

progress.neutral.label: "Upload" 40    ; => <progress class="progress progress-neutral" value="40" max="100" aria-label="Upload"></progress>
progress.secondary.label: "Upload" 40  ; => <progress class="progress progress-secondary" value="40" max="100" aria-label="Upload"></progress>
progress.accent.label: "Upload" 40     ; => <progress class="progress progress-accent" value="40" max="100" aria-label="Upload"></progress>
progress.info.label: "Upload" 40       ; => <progress class="progress progress-info" value="40" max="100" aria-label="Upload"></progress>
progress.success.label: "Upload" 100   ; => <progress class="progress progress-success" value="100" max="100" aria-label="Upload"></progress>
progress.warning.label: "Upload" 40    ; => <progress class="progress progress-warning" value="40" max="100" aria-label="Upload"></progress>
progress.error.label: "Upload" 0       ; => <progress class="progress progress-error" value="0" max="100" aria-label="Upload"></progress>
