; Tooltip
;
; A component wraps its trigger in a div, matching the FAB examples.
; .text becomes data-tip; the positional argument supplies the trigger.
; Placement, alignment, color, and .open flags apply to the tooltip container.
; Top placement and centered alignment are the defaults.

tooltip.text: "Save changes" -> button "Save"

; => <div class="tooltip" data-tip="Save changes">
;   <button class="btn">Save</button>
; </div>


; Tooltip placement

tooltip.bottom.text: "Save changes" -> button "Save"

; => <div class="tooltip tooltip-bottom" data-tip="Save changes">
;   <button class="btn">Save</button>
; </div>

tooltip.left.text: "Save changes" -> button "Save"

; => <div class="tooltip tooltip-left" data-tip="Save changes">
;   <button class="btn">Save</button>
; </div>

tooltip.right.text: "Save changes" -> button "Save"

; => <div class="tooltip tooltip-right" data-tip="Save changes">
;   <button class="btn">Save</button>
; </div>


; Tooltip alignment

tooltip.top.start.text: "Save changes" -> button "Save"

; => <div class="tooltip tooltip-top tooltip-start" data-tip="Save changes">
;   <button class="btn">Save</button>
; </div>

tooltip.top.end.text: "Save changes" -> button "Save"

; => <div class="tooltip tooltip-top tooltip-end" data-tip="Save changes">
;   <button class="btn">Save</button>
; </div>


; Always-visible Tooltip

tooltip.open.text: "Save changes" -> button "Save"

; => <div class="tooltip tooltip-open" data-tip="Save changes">
;   <button class="btn">Save</button>
; </div>


; Tooltip colors
;
; The trigger's color stays independent of the tooltip's color.

tooltip.primary.text: "Save changes" -> button.primary "Save"

; => <div class="tooltip tooltip-primary" data-tip="Save changes">
;   <button class="btn btn-primary">Save</button>
; </div>

tooltip.secondary.text: "Help" -> button "Help"

; => <div class="tooltip tooltip-secondary" data-tip="Help">
;   <button class="btn">Help</button>
; </div>

tooltip.accent.text: "Help" -> button "Help"

; => <div class="tooltip tooltip-accent" data-tip="Help">
;   <button class="btn">Help</button>
; </div>

tooltip.info.text: "Help" -> button "Help"

; => <div class="tooltip tooltip-info" data-tip="Help">
;   <button class="btn">Help</button>
; </div>

tooltip.success.text: "Saved" -> button "Status"

; => <div class="tooltip tooltip-success" data-tip="Saved">
;   <button class="btn">Status</button>
; </div>

tooltip.warning.text: "Storage is low" -> button "Status"

; => <div class="tooltip tooltip-warning" data-tip="Storage is low">
;   <button class="btn">Status</button>
; </div>

tooltip.error.text: "Connection lost" -> button "Status"

; => <div class="tooltip tooltip-error" data-tip="Connection lost">
;   <button class="btn">Status</button>
; </div>
