; Drawer sidebar
;
; Named open/content/sidebar/close slots follow the Modal convention.
; Generates the checkbox, main content and sidebar wrappers, overlay, and wiring.
; Open and close are buttons; clicking the overlay also unchecks the toggle.
; This is a sidebar layout, without modal focus trapping or automatic Escape handling.
; Examples supply deterministic IDs. .id sets the root ID,
; with -toggle and -side suffixes used for internal references.

drawer.id: "drawer-a7f3c9e2" #[
    open: button "Open sidebar"
    content: [p "Main page content"]
    sidebar: menu.w: 64 .bg: 'base100 [
        li -> a.href: "/" "Home"
        li -> a.href: "/projects" "Projects"
    ]
    close: button "Close sidebar"
]

; => <div class="drawer" id="drawer-a7f3c9e2">
;   <input type="checkbox" class="drawer-toggle" id="drawer-a7f3c9e2-toggle" aria-hidden="true" tabindex="-1" />
;   <div class="drawer-content">
;     <button type="button" class="btn drawer-button" aria-controls="drawer-a7f3c9e2-side" onclick="document.getElementById('drawer-a7f3c9e2-toggle').checked = true">Open sidebar</button>
;     <p>Main page content</p>
;   </div>
;   <div class="drawer-side" id="drawer-a7f3c9e2-side">
;     <label class="drawer-overlay" for="drawer-a7f3c9e2-toggle" aria-label="Close sidebar"></label>
;     <div class="bg-base-100 min-h-full">
;       <button type="button" class="btn" aria-controls="drawer-a7f3c9e2-side" onclick="document.getElementById('drawer-a7f3c9e2-toggle').checked = false">Close sidebar</button>
;       <ul class="menu w-64 bg-base-100">
;         <li><a href="/">Home</a></li>
;         <li><a href="/projects">Projects</a></li>
;       </ul>
;     </div>
;   </div>
; </div>


; End-side Drawer with explicit ID and initial checked state
;
; .checked starts open but remains closable. Background clicks and the close
; button both update the generated checkbox. Slot wrappers are only emitted
; for supplied content, while the standard drawer/side structure is preserved.

drawer.end.checked.id: "settings-drawer" #[
    open: button "Settings"
    content: [p "Your workspace"]
    sidebar: div.w: 64 [h2 "Settings"]
    close: button "Close settings"
]

; => <div class="drawer drawer-end" id="settings-drawer">
