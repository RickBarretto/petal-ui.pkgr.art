; Permanently open Drawer
;
; .open maps to drawer-open and forces the sidebar visible independently of
; checkbox state. Omit open/close controls for this fixed layout.

drawer.open.id: "workspace-drawer" #[
    content: [p "Your workspace"]
    sidebar: menu.w: 64 [li -> a.href: "/" "Home"]
]

