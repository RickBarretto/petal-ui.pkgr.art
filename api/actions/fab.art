; Floating Action Button with main action

fab #[
    open: button.lg.circle.primary "F"
    main: div ["Main Action", button.lg.circle.secondary "M"]
    actions: [
        div ["Label A", button.lg.circle "A"]
        div ["Label B", button.lg.circle "B"]
        div ["Label C", button.lg.circle "C"]
    ]
]

