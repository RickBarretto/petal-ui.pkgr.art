; </div>

fab.flower #[
    open: button.lg.circle.success "F"
    main: button.lg.circle "M"
    actions: [
        button.lg.circle "A"
        button.lg.circle "B"
        button.lg.circle "C"
        button.lg.circle "D"
    ]
]

