fab.flower #[
    open: button.lg.circle.info "F"
    main: button.lg.circle.success "M"
    actions: [
        tooltip.left.text: "Label A" -> button.lg.circle "A"
        tooltip.left.text: "Label B" -> button.lg.circle "B"
        tooltip.text: "Label C" -> button.lg.circle "C"
        tooltip.text: "Label D" -> button.lg.circle "D"
    ]
]

