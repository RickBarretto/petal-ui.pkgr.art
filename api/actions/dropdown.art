; Basic Dropdown

dropdown #[
    open: button.m: 1 "Click"
    content: menu.bg: 'base100 .rounded .z: 1 .w: 52 .p: 2 .shadow: 'sm [
        li -> a "Item 1"
        li -> a "Item 2"
    ]
]

; => <div class="dropdown">
;   <div tabindex="0" role="button" class="btn m-1">Click</div>
;   <ul tabindex="-1" class="dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm">
;     <li><a>Item 1</a></li>
;     <li><a>Item 2</a></li>
;   </ul>
; </div>


; Dropdown alignments

dropdown.start #[
    open: button.m: 1 "Click ⬅️"
    content: menu.bg: 'base100 .rounded .z: 1 .w: 52 .p: 2 .shadow: 'sm [
        li -> a "Item 1"
        li -> a "Item 2"
    ]
]

