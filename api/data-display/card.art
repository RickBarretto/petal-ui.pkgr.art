; Basic Card
;
; Card takes named slots: image, title, content, and actions. All are optional.
; Image goes in figure, followed by card-body containing the other slots.
; Title becomes h2.card-title; content is inserted directly into card-body.
; Actions are wrapped in card-actions and aligned to the end.
; Omitted slots produce no corresponding wrapper; card-body is only needed
; when title, content, or actions are supplied.
; Width, background, and shadow are set explicitly through utility attributes.

card.bg: 'base100 .w: 96 .shadow: 'sm #[
    image: img.alt: "Shoes" "shoes.jpg"
    title: "New shoes"
    content: [p "Ready for your next adventure."]
    actions: [button.primary "Buy now"]
]

; => <div class="card bg-base-100 w-96 shadow-sm">
;   <figure>
;     <img src="shoes.jpg" alt="Shoes" />
;   </figure>
;   <div class="card-body">
;     <h2 class="card-title">New shoes</h2>
;     <p>Ready for your next adventure.</p>
;     <div class="card-actions justify-end">
;       <button class="btn btn-primary">Buy now</button>
;     </div>
;   </div>
; </div>


; Card without image or actions

card #[
    title: "Welcome"
    content: [p "Make yourself at home."]
]

; => <div class="card">
;   <div class="card-body">
;     <h2 class="card-title">Welcome</h2>
;     <p>Make yourself at home.</p>
;   </div>
; </div>


