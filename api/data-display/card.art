;     <p>Find your next adventure.</p>
;     <div class="card-actions justify-end">
;       <button class="btn btn-primary">Discover</button>
;     </div>
;   </div>
; </div>


; Card sizes
;
; Medium is the default. Size affects spacing and typography, not fixed width.

card.xs #[title: "Xsmall"]

; => <div class="card card-xs">
;   <div class="card-body">
;     <h2 class="card-title">Xsmall</h2>
;   </div>
; </div>

