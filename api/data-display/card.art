; Card with image behind the body
;
; .cover maps to DaisyUI's image-full class.

card.cover #[
    image: img.alt: "Mountain landscape" "mountains.jpg"
    title: "Explore"
    content: [p "Find your next adventure."]
    actions: [button.primary "Discover"]
]

; => <div class="card image-full">
;   <figure>
