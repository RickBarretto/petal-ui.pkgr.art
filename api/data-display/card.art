; Card with image beside the body

card.side #[
    image: img.alt: "Shoes" "shoes.jpg"
    title: "New shoes"
    content: [p "Ready for your next adventure."]
]

; => <div class="card card-side">
;   <figure>
;     <img src="shoes.jpg" alt="Shoes" />
;   </figure>
;   <div class="card-body">
;     <h2 class="card-title">New shoes</h2>
;     <p>Ready for your next adventure.</p>
;   </div>
