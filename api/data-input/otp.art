; One-time code input
;
; Integer argument is the digit count. Generates that many decorative spans
; and one text input, preserving leading zeroes, paste, and native autofill.
; maxlength and numeric pattern match the digit count. .name, .label,
; .value, .required, and .disabled apply to the input; visual modifiers to label.
; No per-digit inputs, focus-moving scripts, or verification service is added.

otp.required.name: "code" .label: "Verification code" 6

; => <label class="otp">
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <input type="text" name="code" aria-label="Verification code" autocomplete="one-time-code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" required />
; </label>


; Joined OTP boxes with color, size, and initial value
;
; Initial values are strings, so a leading zero is retained.

otp.joined.primary.sm.name: "code" .label: "Verification code" .value: "0123" 4

; => <label class="otp otp-joined otp-primary otp-sm">
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <input type="text" name="code" aria-label="Verification code" autocomplete="one-time-code" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" value="0123" />
; </label>


; Disabled OTP input

otp.disabled.label: "Verification code" 4

; => <label class="otp">
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <span aria-hidden="true"></span>
;   <input type="text" aria-label="Verification code" autocomplete="one-time-code" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" disabled />
; </label>
