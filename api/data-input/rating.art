; Rating
;
; Integer argument selects a score from 1 to count; count defaults to 5.
; Generates numbered radio values with a shared random name, or .name override.
; The default mask is star and size is medium. Labels describe the numeric score
; rather than assuming that every custom shape is a star. No half ratings yet.

rating 3

; => <div class="rating" role="radiogroup" aria-label="Rating">
;   <input type="radio" name="rating-a7f3c9e2" value="1" class="mask mask-star" aria-label="1 out of 5" />
;   <input type="radio" name="rating-a7f3c9e2" value="2" class="mask mask-star" aria-label="2 out of 5" />
;   <input type="radio" name="rating-a7f3c9e2" value="3" class="mask mask-star" aria-label="3 out of 5" checked />
;   <input type="radio" name="rating-a7f3c9e2" value="4" class="mask mask-star" aria-label="4 out of 5" />
;   <input type="radio" name="rating-a7f3c9e2" value="5" class="mask mask-star" aria-label="5 out of 5" />
; </div>


; Rating with custom count, mask, size, and submission name

rating.sm.mask: 'heart .count: 3 .name: "satisfaction" 2

; => <div class="rating rating-sm" role="radiogroup" aria-label="Rating">
;   <input type="radio" name="satisfaction" value="1" class="mask mask-heart" aria-label="1 out of 3" />
;   <input type="radio" name="satisfaction" value="2" class="mask mask-heart" aria-label="2 out of 3" checked />
;   <input type="radio" name="satisfaction" value="3" class="mask mask-heart" aria-label="3 out of 3" />
; </div>


; Read-only Rating
;
; Generates decorative shapes instead of radio inputs. The outer image role
; announces the whole score. aria-current marks the filled boundary for CSS.

rating.frozen 4

; => <div class="rating" role="img" aria-label="4 out of 5">
;   <div class="mask mask-star" aria-hidden="true"></div>
;   <div class="mask mask-star" aria-hidden="true"></div>
;   <div class="mask mask-star" aria-hidden="true"></div>
;   <div class="mask mask-star" aria-hidden="true" aria-current="true"></div>
;   <div class="mask mask-star" aria-hidden="true"></div>
; </div>
