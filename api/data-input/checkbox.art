; Checkbox
;
; check is the short form of input.checkbox outside the theme context.
; Its string is an accessible label, not a form value or visible caption.
; Use .value explicitly for submitted data; .checked sets initial selection.

check.name: "remember" .value: "yes" "Remember me"

; => <input type="checkbox" class="checkbox" name="remember" value="yes" aria-label="Remember me" />


; Checked Checkbox with color and size

check.primary.sm.checked.name: "terms" .value: "accepted" "Accept terms"

; => <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" name="terms" value="accepted" aria-label="Accept terms" checked />


; Explicit input.checkbox form
;
; .as: :button still uses the existing button API instead of checkbox styling.

input.checkbox.disabled.checked "Unavailable option"

; => <input type="checkbox" class="checkbox" aria-label="Unavailable option" disabled checked />


; Checkbox with a visible label
;
; The enclosing label supplies the accessible name when the string is empty.

label [
    check.name: "newsletter" .value: "yes" ""
    "Subscribe to updates"
]

; => <label class="label">
;   <input type="checkbox" class="checkbox" name="newsletter" value="yes" />
;   Subscribe to updates
; </label>
