; Radio buttons
;
; String supplies the accessible label;
; .value is the submitted value. Related options explicitly share .name.
; Use a distinct name for each independent group; select at most one .checked.

div [
    radio.name: "plan" .value: "free" .checked "Free"
    radio.name: "plan" .value: "pro" "Pro"
]

; => <div>
;   <input type="radio" class="radio" name="plan" value="free" aria-label="Free" checked />
;   <input type="radio" class="radio" name="plan" value="pro" aria-label="Pro" />
; </div>


; Radio color and size

radio.primary.sm.name: "delivery" .value: "standard" .checked "Standard delivery"

; => <input type="radio" class="radio radio-primary radio-sm" name="delivery" value="standard" aria-label="Standard delivery" checked />


; Disabled Radio

radio.disabled.name: "delivery" .value: "express" "Express delivery"

; => <input type="radio" class="radio" name="delivery" value="express" aria-label="Express delivery" disabled />
