import {unitt}!
import {src/lib.art}!

describe "Petal entry point" [
    it "returns HTML markup and delegates escaping" [
        value: petal [button.primary "Save & continue"]
        expects.be: 'equal? @[true is? :htmlMarkup value]
        expects.be: 'equal? @[to :string value {<button class="btn btn-primary">Save &amp; continue</button>}]
    ]
]

if and? standalone? not? key? args 'filename ::
    unitt\report 'full
